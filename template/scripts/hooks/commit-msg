#!/bin/bash
# Every commit names the bead it came from. Blocking, on purpose: the ledger is
# only worth reading if it's complete, and "I'll file it after" never happens.
#
# Installed by pointing a commit-msg hook at this file. The logic lives in
# scripts/ rather than in the hook directory itself because that directory is
# managed by beads and gets rewritten on upgrade.
set -uo pipefail

msg_file="$1"
git_dir="$(git rev-parse --git-dir)"

# The shared checkout, for the journal lib below: set by `scripts/harness
# hook`, else the tree this hook file lives in. Guarded at use, so a checkout
# without the lib journals nothing rather than failing the commit.
HARNESS="${HARNESS_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." 2>/dev/null && pwd -P)}"
if [ -n "${HARNESS:-}" ] && [ -f "$HARNESS/scripts/lib/journal.sh" ]; then
  . "$HARNESS/scripts/lib/journal.sh"
fi

# Whether the staged tree carries a committed handoff note: the close's own
# record. Live journal files (.live-*.md) are the session's scratch, never a
# close.
staged_handoff_note() {
  local path
  while IFS= read -r -d '' path; do
    case "$path" in
      harness/handoffs/.live-*.md) ;;
      harness/handoffs/*.md) return 0;;
    esac
  done < <(git diff --cached --name-only --no-renames -z)
  return 1
}

# A merge resolves other commits that already named their beads, and a bisect or
# a cherry-pick is replaying someone else's message. Neither is new work.
[ -e "$git_dir/MERGE_HEAD" ] && exit 0
[ -e "$git_dir/CHERRY_PICK_HEAD" ] && exit 0
[ -e "$git_dir/BISECT_LOG" ] && exit 0

# Comment lines aren't part of the message, and the diff git appends under
# --verbose would otherwise match any bead id that happens to be in the patch.
message="$(sed -e '/^#/d' -e '/^diff --git/,$d' "$msg_file")"

# `fixup!` and `squash!` fold into a commit that already carries the reference.
case "$message" in fixup!*|squash!*|amend!*) exit 0 ;; esac

# The ledger's bead prefix, asked of the ledger itself at runtime — it used to be
# baked into this file at install time, which made every copy differ. Derived
# from the directory name when the ledger has nothing to say, the same way
# `harness add` does, so a fresh clone can still commit.
harness_prefix() {
  local p=""
  if command -v bd >/dev/null 2>&1; then
    # Never `bd config get` or `bd info` here: both auto-import a stale
    # .beads/issues.jsonl when the ledger looks stale to them, resurrecting
    # deleted beads — and this hook runs on every commit, the exact moment a
    # deletion committed without a regen would come back (har-67c). `bd list`
    # never imports, so the prefix comes from the first bead id instead; the
    # per-id `bd show` check below is a quiet read and stays as is.
    p="$(bd list --json --all 2>/dev/null | python3 -c 'import json,sys; d=json.load(sys.stdin); i=(d[0].get("id","") if d else ""); print(i.split("-",1)[0] if "-" in i else "")' 2>/dev/null)" || true
  fi
  if ! printf '%s' "$p" | grep -qE '^[a-z0-9]{1,10}$'; then
    # Physical path: git runs hooks from the toplevel, and -P matches what
    # `harness add` derived at install time and what the Python scripts
    # resolve — through a symlink the logical name could be anything.
    p="$(basename "$(pwd -P)" \
        | tr 'A-Z' 'a-z' | tr -cd '[:alnum:]' | sed 's/^[0-9]*//' | cut -c1-3)"
    [ -n "$p" ] || p="bd"
  fi
  printf '%s\n' "$p"
}
# Session artifacts carry their own context and do not need a work bead. Keep
# this exception tied to the two generated capture locations; any source file
# alongside one of them makes the commit require a bead as usual.
artifact_only_commit() {
  local path count=0
  while IFS= read -r -d '' path; do
    count=$((count + 1))
    case "$path" in
      harness/laurels.jsonl) ;;
      harness/handoffs/.live-*.md) return 1;;
      *)
        if [[ "$path" =~ ^harness/handoffs/[^/]+\.md$ ]]; then
          :
        else
          return 1
        fi
        ;;
    esac
  done < <(git diff --cached --name-only --no-renames -z)
  [ "$count" -gt 0 ]
}

if artifact_only_commit; then
  # The close's own commit (or a laurels-only one): no bead to name, but the
  # journal still records it — and a staged handoff note means this session
  # is closing, so its own live file goes. Never another session's.
  if command -v journal_event >/dev/null 2>&1; then
    journal_event "commit" "artifact-only"
    if staged_handoff_note; then
      journal_close
    fi
  fi
  exit 0
fi

prefix="$(harness_prefix)"

ids="$(printf '%s' "$message" | grep -oE "\\b$prefix-[a-z0-9]+(\.[0-9]+)?\\b" | sort -u)"

if [ -z "$ids" ]; then
  cat >&2 <<'EOF'

  ✗ this commit names no bead.

    Every commit links to the work it came from — that link is what lets a
    later session ask why a line looks the way it does and get an answer.

      bd q "what this commit is doing"    # file one, get an id back
      bd ready                            # or claim something already filed

    Then put the id in the message: "Closes <bead-id>", or just the id in the body.

EOF
  exit 1
fi

# A typo'd id is worse than none: it looks like a link and resolves to nothing.
# Only checked when bd is actually installed, so a fresh clone can still commit.
if command -v bd >/dev/null 2>&1; then
  unknown=""
  for id in $ids; do
    bd show "$id" >/dev/null 2>&1 || unknown="$unknown $id"
  done
  if [ -n "$unknown" ]; then
    echo >&2
    echo >&2 "  ✗ no such bead:$unknown"
    echo >&2 "    Check the id with 'bd list', or file it with 'bd q \"…\"'."
    echo >&2
    exit 1
  fi
fi

# The session's live journal: one machine-written line naming the bead. Loud
# but never blocking: a missing session id must not fail a commit. Never
# closed here, even when this commit carries a handoff note: a mixed commit
# (`git add -A` sweeping another session's note alongside bead work) is not a
# close, and closing would delete this session's live file mid-session. The
# missed close costs one cosmetic orphan line in the brief; a deleted active
# journal is destroyed state.
if command -v journal_event >/dev/null 2>&1; then
  journal_event "commit" "$ids"
fi

exit 0
