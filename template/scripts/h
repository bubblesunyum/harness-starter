#!/bin/bash
# scripts/h — find the harness root, then run it for this project.
#
# A project commits this file as scripts/h. It resolves the harness root —
# the template/ tree holding .harness-root — in order: $HARNESS_HOME,
# ~/.harness, a fetched copy in .harness/. Then:
#
#   scripts/h root                       print the resolved root, nothing else
#   scripts/h doctor                     project, root, source, shadows
#   scripts/h link                       symlink shared skills/agents here
#   scripts/h brief|verify|review|...    run the shared script for this project
#
# Resolution itself is silent on both streams, so `h root` and dispatch keep
# machine-readable output clean. The fetch announces itself on stderr and
# doctor reports the source. Every failure is one line on stderr naming
# the fix.
#
# Bash 3.2 only (macOS /bin/bash): no associative arrays, no ${x,,},
# no mapfile, no `local -n`.

MARKER=".harness-root"
DEFAULT_URL="https://github.com/bubblesunyum/harness-starter.git"

# PROJECT is the parent of the directory holding this file, physically
# resolved. The caller's cwd never matters, and a symlinked finder is not
# followed — installs commit a real file.
FINDER_DIR="$(cd "$(dirname "$0")" && pwd -P)"
PROJECT="$(dirname "$FINDER_DIR")"

ROOT=""
SOURCE=""

fail() {
  printf '✗ harness: %s — %s\n' "$1" "$2" >&2
  exit "${3:-1}"
}

# Append $2 to $1 when no exact line matches; create the file when absent.
ensure_gitignore() {
  if [ ! -f "$1" ]; then
    printf '%s\n' "$2" > "$1"
    return 0
  fi
  if grep -qxF "$2" "$1" 2>/dev/null; then
    return 0
  fi
  # A file without a trailing newline would glue the append onto its last
  # line; command substitution strips newlines, so non-empty means missing.
  if [ -n "$(tail -c 1 "$1")" ]; then
    printf '\n' >> "$1"
  fi
  printf '%s\n' "$2" >> "$1"
}

fetch() {
  url="${HARNESS_URL:-$DEFAULT_URL}"
  tmp="$PROJECT/.harness-tmp.$$"
  rm -rf "$tmp"
  printf 'harness: fetching %s ...\n' "$url" >&2
  if ! GIT_TERMINAL_PROMPT=0 git -c http.lowSpeedLimit=1000 -c http.lowSpeedTime=30 clone --depth 1 "$url" "$tmp" >&2; then
    rm -rf "$tmp"
    fail "cannot fetch $url" "check the URL, or avoid the fetch with HARNESS_HOME or ~/.harness"
  fi
  if [ ! -f "$tmp/template/$MARKER" ]; then
    rm -rf "$tmp"
    fail "$url is not a harness checkout (no template/$MARKER)" "point HARNESS_URL at a harness-starter clone, or set HARNESS_HOME"
  fi
  if ! mv "$tmp" "$PROJECT/.harness"; then
    rm -rf "$tmp"
    fail "cannot move the fetched copy into $PROJECT/.harness" "check permissions in $PROJECT"
  fi
  ROOT="$PROJECT/.harness/template"
  SOURCE="fetched"
  ensure_gitignore "$PROJECT/.gitignore" ".harness/"
}

resolve() {
  # $HARNESS_HOME names a starter checkout; a bad one fails outright, so a
  # typo never silently resolves somewhere else.
  if [ -n "${HARNESS_HOME:-}" ]; then
    if [ -f "$HARNESS_HOME/template/$MARKER" ]; then
      ROOT="$HARNESS_HOME/template"
      SOURCE="HARNESS_HOME"
    else
      fail "HARNESS_HOME=$HARNESS_HOME is not a harness checkout (no template/$MARKER)" "point it at a harness-starter clone, or unset it"
    fi
  # ~/.harness, dir or symlink; a bad one fails outright like HARNESS_HOME.
  elif [ -n "${HOME:-}" ] && { [ -e "$HOME/.harness" ] || [ -L "$HOME/.harness" ]; }; then
    if [ -f "$HOME/.harness/template/$MARKER" ]; then
      ROOT="$HOME/.harness/template"
      SOURCE="~/.harness"
    else
      fail "~/.harness is not a harness checkout (no template/$MARKER)" "replace it with a harness-starter clone, or set HARNESS_HOME"
    fi
  # A previous fetch: valid reuses it, anything else is a stale fetch with
  # its own fix — never silently re-fetched over.
  elif [ -e "$PROJECT/.harness" ] || [ -L "$PROJECT/.harness" ]; then
    if [ -f "$PROJECT/.harness/template/$MARKER" ]; then
      ROOT="$PROJECT/.harness/template"
      SOURCE="fetched"
    else
      fail "$PROJECT/.harness is a stale fetch (no template/$MARKER)" "rm -rf .harness and rerun, or set HARNESS_HOME"
    fi
  else
    fetch
  fi
  # Absolute and physical: a relative HARNESS_HOME would otherwise break the
  # moment dispatch cds into the project.
  ROOT="$(cd "$ROOT" && pwd -P)" || fail "cannot resolve $ROOT" "check the harness root path"
}

usage() {
  cat <<'EOF'
usage: h [-h|--help] <command> [args]
  root        print the resolved harness root
  doctor      show project, root, source, revision, and shadows
  link        symlink shared skills/agents into this project
  brief       session brief
  verify      run the gate
  review      build a review packet
  wrap-up     close-out checks
  ledger-push push the ledger
  agent       run the agent runner
  context     project context
  dashboard   dashboard server
  models      model configuration
EOF
}

cmd_doctor() {
  rev=""
  rev="$(git -C "$ROOT" rev-parse --short HEAD 2>/dev/null)" || rev=""
  if [ -z "$rev" ]; then
    rev="unknown"
  fi
  printf 'project: %s\n' "$PROJECT"
  printf 'root: %s\n' "$ROOT"
  printf 'source: %s\n' "$SOURCE"
  printf 'revision: %s\n' "$rev"
  # Every shared script the project shadows or overlays. verify.steps.sh
  # and review.scope.sh are overlays the project extends; anything else a
  # project copy fully replaces is a shadow.
  find "$ROOT/scripts" -type f -print | sort | while read -r f; do
    case "$f" in
      # The finder is committed in every project by design, not a shadow.
      *__pycache__*|*.pyc|*/scripts/h) continue ;;
    esac
    rel="${f#$ROOT/}"
    if [ -e "$PROJECT/$rel" ] || [ -L "$PROJECT/$rel" ]; then
      case "$(basename "$f")" in
        verify.steps.sh|review.scope.sh) printf 'overlay: %s\n' "$rel" ;;
        *) printf 'shadow: %s\n' "$rel" ;;
      esac
    fi
  done
}

# Link one shared entry into the project dir: an already-correct link stays,
# a stray link is replaced, a real project file wins silently. $1 is the
# shared entry, $2 the project dir, $3 the gitignore/display path.
link_entry() {
  entry="$1"
  dir="$2"
  rel="$3"
  target="$dir/$(basename "$entry")"
  if [ -L "$target" ]; then
    if [ "$(readlink "$target")" = "$entry" ]; then
      :
    else
      rm -f "$target"
      ln -s "$entry" "$target"
      printf 'harness: re-linked %s -> %s\n' "$rel" "$entry" >&2
    fi
  elif [ -e "$target" ]; then
    # The project's own file or dir beside the shared ones: leave it alone.
    return 0
  else
    ln -s "$entry" "$target"
    printf 'harness: linked %s -> %s\n' "$rel" "$entry" >&2
  fi
  ensure_gitignore "$PROJECT/.gitignore" "$rel"
}

# Drop the exact whole-dir gitignore line when replacing an older whole-dir
# link: it would now match the real dir and hide the project's own entries.
unignore_dir() {
  if [ -f "$1" ] && grep -qxF "$2" "$1" 2>/dev/null; then
    grep -vxF "$2" "$1" > "$1.tmp" || true
    mv "$1.tmp" "$1" || fail "cannot update $1" "check permissions in $PROJECT"
  fi
}

# Remove dangling links that point into a harness root: a shared entry
# deleted upstream. Anything else broken is the project's own, hands off.
prune_dead_links() {
  dir="$1"
  pat="/template/$2/"
  for target in "$dir"/*; do
    if [ -L "$target" ] && [ ! -e "$target" ]; then
      case "$(readlink "$target")" in
        *"$pat"*) rm -f "$target" ;;
      esac
    fi
  done
}

cmd_link() {
  for p in .claude/skills .claude/agents .agents/skills; do
    src="$ROOT/$p"
    dst="$PROJECT/$p"
    # No shared entries here, nothing to link.
    if [ ! -e "$src" ] && [ ! -L "$src" ]; then
      continue
    fi
    # An older whole-dir link becomes a real dir of per-entry links.
    if [ -L "$dst" ]; then
      rm -f "$dst"
      unignore_dir "$PROJECT/.gitignore" "$p"
    fi
    if [ -e "$dst" ] && [ ! -d "$dst" ]; then
      fail "$dst is a file, want a directory of links" "move it aside and rerun"
    fi
    mkdir -p "$dst" || fail "cannot make $dst" "check permissions in $PROJECT"
    # Agents link by file; skill dirs link by entry, so a project keeps its
    # own skills beside the shared ones.
    if [ "$p" = ".claude/agents" ]; then
      for e in "$src"/*.md; do
        if [ -e "$e" ] || [ -L "$e" ]; then
          link_entry "$e" "$dst" "$p/$(basename "$e")"
        fi
      done
    else
      for e in "$src"/*; do
        if [ -e "$e" ] || [ -L "$e" ]; then
          link_entry "$e" "$dst" "$p/$(basename "$e")"
        fi
      done
    fi
    prune_dead_links "$dst" "$p"
  done
}

cmd_dispatch() {
  name="$1"
  shift
  case "$name" in
    brief) file="brief.sh" ;;
    verify) file="verify.sh" ;;
    review) file="review.sh" ;;
    wrap-up) file="wrap-up.sh" ;;
    ledger-push) file="ledger-push.sh" ;;
    agent) file="agent.py" ;;
    context) file="context.py" ;;
    dashboard) file="dashboard.py" ;;
    models) file="models.py" ;;
    *) fail "no such command '$name'" "use one of: root doctor link brief verify review wrap-up ledger-push agent context dashboard models" 2 ;;
  esac
  # A project copy shadows the shared one; that is how overlays win.
  if [ -f "$PROJECT/scripts/$file" ]; then
    file="$PROJECT/scripts/$file"
  elif [ -f "$ROOT/scripts/$file" ]; then
    file="$ROOT/scripts/$file"
  else
    fail "$name is missing (no scripts/$(basename "$file") under the project or $ROOT)" "re-resolve with a valid harness root"
  fi
  cd "$PROJECT" || fail "cannot cd to $PROJECT" "check the project directory"
  HARNESS_PROJECT="$PROJECT" HARNESS_ROOT="$ROOT" HARNESS_SOURCE="$SOURCE"
  export HARNESS_PROJECT HARNESS_ROOT HARNESS_SOURCE
  case "$file" in
    *.py) exec python3 "$file" "$@" ;;
    *) exec bash "$file" "$@" ;;
  esac
}

main() {
  if [ $# -eq 0 ]; then
    usage
    exit 0
  fi
  case "$1" in
    -h|--help)
      usage
      ;;
    root)
      resolve
      printf '%s\n' "$ROOT"
      ;;
    doctor)
      resolve
      cmd_doctor
      ;;
    link)
      resolve
      cmd_link
      ;;
    *)
      resolve
      cmd_dispatch "$@"
      ;;
  esac
}

main "$@"
