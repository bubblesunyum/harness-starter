#!/bin/bash
# scripts/harness — find the harness root, then run it for this project.
#
# A project commits this file as scripts/harness. It resolves the harness root —
# the template/ tree holding .harness-root — in order: its own template/
# when the project IS a starter checkout, then $HARNESS_HOME,
# ~/.harness, a fetched copy in .harness/. Then:
#
#   scripts/harness root                       print the resolved root, nothing else
#   scripts/harness doctor                     project, root, source, shadows
#   scripts/harness link                       symlink shared skills/agents/stacks here
#   scripts/harness session [--hook]           link, then the contract plus the brief
#   scripts/harness hook <name> [args]         run the shared hook for this project
#   scripts/harness brief|verify|review|reflect|...    run the shared script for this project
#
# Resolution itself is silent on both streams, so `harness root` and dispatch keep
# machine-readable output clean. The fetch announces itself on stderr and
# doctor reports the source. Every failure is one line on stderr naming
# the fix.
#
# Bash 3.2 only (macOS /bin/bash): no associative arrays, no ${x,,},
# no mapfile, no `local -n`.

MARKER=".harness-root"
DEFAULT_URL="https://github.com/bubblesunyum/harness-starter.git"

# PROJECT is the parent of the directory holding this file, physically
# resolved. The caller's cwd never matters, and a symlinked finder is not
# followed — installs commit a real file.
FINDER_DIR="$(cd "$(dirname "$0")" && pwd -P)"
PROJECT="$(dirname "$FINDER_DIR")"

# A project's committed finder is a copy and goes stale; the shared one does
# not. So the committed copy only locates the harness, then hands the whole
# command to ROOT/scripts/harness with what it found — every fix to the finder is
# live in every project, like any other shared script. The handed-to finder
# takes the project and root from these instead of its own location.
# Read once and unset: children (agents, the brief, task buttons) must never
# inherit a hand-over meant for this one command.
HANDED_ROOT=""
HANDED_SOURCE=""
if [ -n "${HARNESS_FINDER_PROJECT:-}" ] && [ -n "${HARNESS_FINDER_ROOT:-}" ]; then
  PROJECT="$HARNESS_FINDER_PROJECT"
  HANDED_ROOT="$HARNESS_FINDER_ROOT"
  HANDED_SOURCE="${HARNESS_FINDER_SOURCE:-handed over}"
fi
unset HARNESS_FINDER_PROJECT HARNESS_FINDER_ROOT HARNESS_FINDER_SOURCE

ROOT=""
SOURCE=""

# Whether cmd_link created fresh skill links this run, which is what
# `session` reports — Claude Code only discovers skills present at launch.
# link_context says what kind is being linked ("skill" for skill dirs,
# "agent" for agent file dirs); only a fresh skill link sets the flag.
skill_linked_new=0
link_context=""

fail() {
  printf '✗ harness: %s — %s\n' "$1" "$2" >&2
  exit "${3:-1}"
}

# Append $2 to $1 when no exact line matches; create the file when absent.
ensure_gitignore() {
  if [ ! -f "$1" ]; then
    printf '%s\n' "$2" > "$1"
    return 0
  fi
  if grep -qxF "$2" "$1" 2>/dev/null; then
    return 0
  fi
  # A file without a trailing newline would glue the append onto its last
  # line; command substitution strips newlines, so non-empty means missing.
  if [ -n "$(tail -c 1 "$1")" ]; then
    printf '\n' >> "$1"
  fi
  printf '%s\n' "$2" >> "$1"
}

fetch() {
  url="${HARNESS_URL:-$DEFAULT_URL}"
  tmp="$PROJECT/.harness-tmp.$$"
  rm -rf "$tmp"
  printf 'harness: fetching %s ...\n' "$url" >&2
  if ! GIT_TERMINAL_PROMPT=0 git -c http.lowSpeedLimit=1000 -c http.lowSpeedTime=30 clone --depth 1 "$url" "$tmp" >&2; then
    rm -rf "$tmp"
    fail "cannot fetch $url" "check the URL, or avoid the fetch with HARNESS_HOME or ~/.harness"
  fi
  if [ ! -f "$tmp/template/$MARKER" ]; then
    rm -rf "$tmp"
    fail "$url is not a harness checkout (no template/$MARKER)" "point HARNESS_URL at a harness-starter clone, or set HARNESS_HOME"
  fi
  if ! mv "$tmp" "$PROJECT/.harness"; then
    rm -rf "$tmp"
    fail "cannot move the fetched copy into $PROJECT/.harness" "check permissions in $PROJECT"
  fi
  ROOT="$PROJECT/.harness/template"
  SOURCE="fetched"
  ensure_gitignore "$PROJECT/.gitignore" ".harness/"
}

resolve() {
  # Handed over by a project's committed finder, which already resolved.
  if [ -n "$HANDED_ROOT" ]; then
    ROOT="$HANDED_ROOT"
    SOURCE="$HANDED_SOURCE"
    return 0
  fi
  # A starter checkout resolves to its own template/ first, ahead of
  # HARNESS_HOME and ~/.harness, so editing template/ takes effect in the
  # starter immediately with no machine setup.
  if [ -f "$PROJECT/template/$MARKER" ]; then
    ROOT="$PROJECT/template"
    SOURCE="starter"
  elif [ -n "${HARNESS_HOME:-}" ]; then
    # A bad HARNESS_HOME fails outright, so a typo never silently resolves
    # somewhere else.
    if [ -f "$HARNESS_HOME/template/$MARKER" ]; then
      ROOT="$HARNESS_HOME/template"
      SOURCE="HARNESS_HOME"
    else
      fail "HARNESS_HOME=$HARNESS_HOME is not a harness checkout (no template/$MARKER)" "point it at a harness-starter clone, or unset it"
    fi
  # ~/.harness, dir or symlink; a bad one fails outright like HARNESS_HOME.
  elif [ -n "${HOME:-}" ] && { [ -e "$HOME/.harness" ] || [ -L "$HOME/.harness" ]; }; then
    if [ -f "$HOME/.harness/template/$MARKER" ]; then
      ROOT="$HOME/.harness/template"
      SOURCE="~/.harness"
    else
      fail "~/.harness is not a harness checkout (no template/$MARKER)" "replace it with a harness-starter clone, or set HARNESS_HOME"
    fi
  # A previous fetch: valid reuses it, anything else is a stale fetch with
  # its own fix — never silently re-fetched over.
  elif [ -e "$PROJECT/.harness" ] || [ -L "$PROJECT/.harness" ]; then
    if [ -f "$PROJECT/.harness/template/$MARKER" ]; then
      ROOT="$PROJECT/.harness/template"
      SOURCE="fetched"
    else
      fail "$PROJECT/.harness is a stale fetch (no template/$MARKER)" "rm -rf .harness and rerun, or set HARNESS_HOME"
    fi
  else
    fetch
  fi
  # Absolute and physical: a relative HARNESS_HOME would otherwise break the
  # moment dispatch cds into the project.
  ROOT="$(cd "$ROOT" && pwd -P)" || fail "cannot resolve $ROOT" "check the harness root path"
}

usage() {
  cat <<'EOF'
usage: h [-h|--help] <command> [args]
  root        print the resolved harness root
  doctor      show project, root, source, revision, and shadows
  link        symlink shared skills/agents/stacks into this project
  session     link, then the contract plus the brief [--hook for SessionStart JSON]
  hook        run the shared hook for this project
  brief       session brief
  verify      run the gate
  review      build a review packet
  reflect     build a reflect packet and preview candidates
  wrap-up     close-out checks
  ledger-push push the ledger
  ledger-export-check  check the committed ledger export matches
  agent       run the agent runner
  context     project context
  dashboard   dashboard server
  dashboard-persist  dashboard server that survives session end
  models      model configuration
  codex-support  generate or check Codex agents and skill links
  opencode-agents  regenerate opencode agents and pins
  opencode-pin  fail on any opencode model outside the pin
EOF
}

cmd_doctor() {
  rev=""
  rev="$(git -C "$ROOT" rev-parse --short HEAD 2>/dev/null)" || rev=""
  if [ -z "$rev" ]; then
    rev="unknown"
  fi
  printf 'project: %s\n' "$PROJECT"
  printf 'root: %s\n' "$ROOT"
  printf 'source: %s\n' "$SOURCE"
  printf 'revision: %s\n' "$rev"
  # Every shared script the project shadows or overlays. verify.steps.sh
  # and review.scope.sh are overlays the project extends; anything else a
  # project copy fully replaces is a shadow.
  find "$ROOT/scripts" -type f -print | sort | while read -r f; do
    case "$f" in
      # The finder is committed in every project by design, not a shadow.
      *__pycache__*|*.pyc|*/scripts/harness|*/scripts/h) continue ;;
    esac
    rel="${f#$ROOT/}"
    if [ -e "$PROJECT/$rel" ] || [ -L "$PROJECT/$rel" ]; then
      case "$(basename "$f")" in
        verify.steps.sh|review.scope.sh) printf 'overlay: %s\n' "$rel" ;;
        *) printf 'shadow: %s\n' "$rel" ;;
      esac
    fi
  done
}

# Link one shared entry into the project dir: an already-correct link stays,
# a stray link is replaced, a real project file wins silently. $1 is the
# shared entry, $2 the project dir, $3 the gitignore/display path.
link_entry() {
  entry="$1"
  dir="$2"
  rel="$3"
  target="$dir/$(basename "$entry")"
  if [ -L "$target" ]; then
    if [ "$(readlink "$target")" = "$entry" ]; then
      :
    else
      rm -f "$target"
      ln -s "$entry" "$target"
      printf 'harness: re-linked %s -> %s\n' "$rel" "$entry" >&2
      if [ "$link_context" = "skill" ]; then skill_linked_new=1; fi
    fi
  elif [ -e "$target" ]; then
    # The project's own file or dir beside the shared ones: leave it alone.
    return 0
  else
    ln -s "$entry" "$target"
    printf 'harness: linked %s -> %s\n' "$rel" "$entry" >&2
    if [ "$link_context" = "skill" ]; then skill_linked_new=1; fi
  fi
  ensure_gitignore "$PROJECT/.gitignore" "$rel"
}

# Drop the exact whole-dir gitignore line when replacing an older whole-dir
# link: it would now match the real dir and hide the project's own entries.
unignore_dir() {
  if [ -f "$1" ] && grep -qxF "$2" "$1" 2>/dev/null; then
    grep -vxF "$2" "$1" > "$1.tmp" || true
    mv "$1.tmp" "$1" || fail "cannot update $1" "check permissions in $PROJECT"
  fi
}

# Remove dangling links that point into a harness root: a shared entry
# deleted upstream. Anything else broken is the project's own, hands off.
prune_dead_links() {
  dir="$1"
  pat="/template/$2/"
  for target in "$dir"/*; do
    if [ -L "$target" ] && [ ! -e "$target" ]; then
      case "$(readlink "$target")" in
        *"$pat"*) rm -f "$target" ;;
      esac
    fi
  done
}

cmd_link() {
  skill_linked_new=0
  for p in .claude/skills .claude/agents .agents/skills .opencode/agent; do
    src="$ROOT/$p"
    dst="$PROJECT/$p"
    # No shared entries here, nothing to link — .opencode/agent only exists
    # once the generated agents land, so older checkouts skip it quietly.
    if [ ! -e "$src" ] && [ ! -L "$src" ]; then
      continue
    fi
    # An older whole-dir link becomes a real dir of per-entry links.
    if [ -L "$dst" ]; then
      rm -f "$dst"
      unignore_dir "$PROJECT/.gitignore" "$p"
    fi
    if [ -e "$dst" ] && [ ! -d "$dst" ]; then
      fail "$dst is a file, want a directory of links" "move it aside and rerun"
    fi
    mkdir -p "$dst" || fail "cannot make $dst" "check permissions in $PROJECT"
    # Agents link by file; skill dirs link by entry, so a project keeps its
    # own skills beside the shared ones.
    if [ "$p" = ".claude/agents" ] || [ "$p" = ".opencode/agent" ]; then
      link_context="agent"
      for e in "$src"/*.md; do
        if [ -e "$e" ] || [ -L "$e" ]; then
          link_entry "$e" "$dst" "$p/$(basename "$e")"
        fi
      done
    else
      link_context="skill"
      for e in "$src"/*; do
        if [ -e "$e" ] || [ -L "$e" ]; then
          link_entry "$e" "$dst" "$p/$(basename "$e")"
        fi
      done
    fi
    link_context=""
    prune_dead_links "$dst" "$p"
  done
  link_stacks
  link_contract
  link_codex
  # The per-session live journal: gitignored, so one session's loop notes
  # never show up as another session's diff. The target's .gitignore is the
  # target's, so this is one line, not a file.
  ensure_gitignore "$PROJECT/.gitignore" "harness/handoffs/.live-*.md"
}

# A name in harness/stacks.txt with no shared guidance: loud, never fatal.
# Names the list, the wanted file, and the stacks that do exist — a link must
# not break the session that called it over a typo.
unknown_stack() {
  printf 'harness: harness/stacks.txt names %s — no shared harness/stacks/%s.md in %s (known: %s) — fix the name or remove it; reviewers get no platform checks for it\n' "'$1'" "$1" "$ROOT" "$2" >&2
}

# Stack guidance for this project's stacks: each name in harness/stacks.txt
# links PROJECT/harness/stacks/<name>.md at the shared
# ROOT/harness/stacks/<name>.md, so the reviewers read current guidance
# without the project copying it. Per-entry links, gitignored per entry like
# the skills: a real file there is the project's own and stays, while a shared
# link that dangles or is no longer listed is pruned. Unknown names stay loud
# but never fatal, and so does everything else here — link runs inside
# session, which must survive it.
link_stacks() {
  srcdir="$ROOT/harness/stacks"
  dstdir="$PROJECT/harness/stacks"
  list="$PROJECT/harness/stacks.txt"
  known=""
  if [ -d "$srcdir" ]; then
    known="$(ls "$srcdir" 2>/dev/null | sed -e 's/\.md$//' | tr '\n' ' ')"
  fi
  [ -n "$known" ] || known="none"
  want=""
  if [ -e "$list" ] || [ -L "$list" ]; then
    # An unreadable list reading as "no stacks" would quietly drop every
    # reviewer's platform checks, so say so instead — still without failing.
    if [ ! -r "$list" ]; then
      printf 'harness: harness/stacks.txt unreadable — fix permissions so reviewers get stack guidance\n' >&2
      return 0
    fi
    want="$(sed -e 's/#.*//' "$list" | sed -e 's/^[[:space:]]*//;s/[[:space:]]*$//' | grep -v '^$' || true)"
  fi
  if [ -n "$want" ]; then
    mkdir -p "$dstdir" || {
      printf 'harness: cannot make harness/stacks in %s — check permissions there\n' "$PROJECT" >&2
      return 0
    }
  fi
  # Command substitution runs the EXIT trap in its own subshell, so the
  # wanted set travels through a loop over a herestring, never a $(...).
  while IFS= read -r name; do
    [ -n "$name" ] || continue
    # A stack name is one path segment; anything else is a typo or worse, and
    # must never become a link outside harness/stacks/.
    if ! printf '%s' "$name" | grep -qE '^[A-Za-z0-9_-][A-Za-z0-9._-]*$'; then
      unknown_stack "$name" "$known"
      continue
    fi
    if [ -e "$srcdir/$name.md" ] || [ -L "$srcdir/$name.md" ]; then
      link_entry "$srcdir/$name.md" "$dstdir" "harness/stacks/$name.md"
    else
      unknown_stack "$name" "$known"
    fi
  done <<< "$want"
  # Prune shared links that dangle or are no longer listed: anything pointing
  # into a harness checkout's stacks. Anything else broken is the project's
  # own, hands off — and a real file is the project's own guidance, left alone.
  if [ -d "$dstdir" ]; then
    for target in "$dstdir"/*.md; do
      [ -L "$target" ] || continue
      case "$(readlink "$target")" in
        *"/template/harness/stacks/"*) ;;
        *) continue ;;
      esac
      base="${target##*/}"
      base="${base%.md}"
      if [ ! -e "$target" ]; then
        rm -f "$target"  # dangling shared entry: gone upstream
      elif printf '%s\n' "$want" | grep -qxF "$base"; then
        :
      else
        rm -f "$target"  # no longer listed
      fi
    done
  fi
  return 0
}

# The opencode-readable copy of the shared contract: a single link, not a
# per-entry dir, so it needs its own few lines rather than link_entry.
link_contract() {
  src="$ROOT/AGENTS.md"
  dst="$PROJECT/.harness-contract.md"
  rel=".harness-contract.md"
  if [ ! -e "$src" ] && [ ! -L "$src" ]; then
    return 0
  fi
  # A real file here is stale generated output, not a project override the
  # way a real skill file is — replace it so the contract stays the contract.
  if [ -L "$dst" ]; then
    if [ "$(readlink "$dst")" = "$src" ]; then
      :
    else
      rm -f "$dst"
      ln -s "$src" "$dst"
      printf 'harness: re-linked %s -> %s\n' "$rel" "$src" >&2
    fi
  else
    rm -f "$dst"
    ln -s "$src" "$dst"
    printf 'harness: linked %s -> %s\n' "$rel" "$src" >&2
  fi
  ensure_gitignore "$PROJECT/.gitignore" "$rel"
}

# Derived Codex agents for a reference install: the shared prompts are the
# source of truth, so a reference project owns no .codex/agents of its own —
# they are gitignored output, regenerated here (a fresh clone's first session)
# rather than failing the gate on stale copies. Copied installs own their
# agents alongside their own generator, so only a project without one — the
# reference shape — gets this. Quiet on success, loud on failure, never fatal:
# a link must not break the session that called it over generated output.
link_codex() {
  if [ -e "$PROJECT/scripts/codex-support.py" ]; then
    return 0
  fi
  if [ ! -f "$ROOT/scripts/codex-support.py" ]; then
    return 0
  fi
  if codex_out="$(HARNESS_PROJECT="$PROJECT" HARNESS_ROOT="$ROOT" HARNESS_SOURCE="$SOURCE" \
      python3 "$ROOT/scripts/codex-support.py" write 2>&1)"; then
    : # quiet on success: the regenerated agents are routine output
  else
    printf 'harness: codex-support write failed in %s — run scripts/harness codex-support write and read the error\n' "$PROJECT" >&2
    [ -n "$codex_out" ] && printf '%s\n' "$codex_out" >&2
  fi
}

# One SessionStart JSON object on stdout, the same shape brief.sh emits. Used
# only when the harness cannot be resolved and there is no brief to wrap —
# the success path delegates to brief.sh so the wrapper stays in one place.
emit_hook_json() {
  text="$1"
  if command -v python3 >/dev/null 2>&1 && python3 -c '
import json, sys
print(json.dumps({"hookSpecificOutput": {
    "hookEventName": "SessionStart",
    "additionalContext": sys.stdin.read().strip(),
}}))' <<< "$text"; then
    :
  else
    esc="$(printf '%s' "$text" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' -e ':a' -e 'N' -e '$!ba' -e 's/\n/\\n/g')"
    printf '{"hookSpecificOutput": {"hookEventName": "SessionStart", "additionalContext": "%s"}}\n' "$esc"
  fi
}

cmd_session() {
  hook_mode=0
  if [ "${1:-}" = "--hook" ]; then
    hook_mode=1
    shift
  fi
  if [ $# -gt 0 ]; then
    fail "no such session option '$1'" "use: h session [--hook]" 2
  fi
  # Soft resolve: resolve() exits the subshell on failure, the parent stays
  # alive to report it softly — a SessionStart hook must never fail the
  # session it opens. ROOT/SOURCE travel back through files.
  tmp_err="$(mktemp)" || fail "cannot make a temp file" "check /tmp"
  tmp_root="$(mktemp)" || fail "cannot make a temp file" "check /tmp"
  tmp_src="$(mktemp)" || fail "cannot make a temp file" "check /tmp"
  if ( resolve 2>"$tmp_err"; printf '%s' "$ROOT" >"$tmp_root"; printf '%s' "$SOURCE" >"$tmp_src" ); then
    resolve_ok=1
  else
    resolve_ok=0
  fi
  if [ "$resolve_ok" -eq 0 ]; then
    loud="$(cat "$tmp_err")"
    if [ -z "$loud" ]; then
      loud="✗ harness: cannot resolve the harness root — set HARNESS_HOME or ~/.harness, or check the network for a fetch"
    fi
    rm -f "$tmp_err" "$tmp_root" "$tmp_src"
    # Exit 0 either way: without a harness there is no contract and no
    # brief, just the one loud line — and the same line on stderr, where a
    # runner that only watches stderr still sees it.
    if [ "$hook_mode" -eq 1 ]; then
      emit_hook_json "$loud"
      printf '%s\n' "$loud" >&2
    else
      printf '%s\n' "$loud"
      printf '%s\n' "$loud" >&2
    fi
    exit 0
  fi
  ROOT="$(cat "$tmp_root")"
  SOURCE="$(cat "$tmp_src")"
  rm -f "$tmp_err" "$tmp_root" "$tmp_src"
  cmd_link
  # The contract every session reads before the brief. A missing AGENTS.md is
  # itself a loud line in the context: a harness without a contract is broken,
  # and silence would read as a healthy session with nothing to do.
  contract_tmp=""
  if [ -r "$ROOT/AGENTS.md" ]; then
    contract_tmp="$(mktemp)" || fail "cannot make a temp file" "check /tmp"
    # A readable path that still won't cat (a directory, a TOCTOU vanish)
    # reads as damaged too, loudly — never an empty silent prepend.
    if ! cat "$ROOT/AGENTS.md" >"$contract_tmp" 2>/dev/null; then
      printf '✗ harness: %s AGENTS.md unreadable — the checkout is damaged; re-fetch it or point HARNESS_HOME at a harness-starter clone\n' "$ROOT" >"$contract_tmp"
    fi
  else
    contract_tmp="$(mktemp)" || fail "cannot make a temp file" "check /tmp"
    if [ -e "$ROOT/AGENTS.md" ] || [ -L "$ROOT/AGENTS.md" ]; then
      printf '✗ harness: %s AGENTS.md unreadable — the checkout is damaged; re-fetch it or point HARNESS_HOME at a harness-starter clone\n' "$ROOT" >"$contract_tmp"
    else
      printf '✗ harness: %s has no AGENTS.md — the checkout is damaged; re-fetch it or point HARNESS_HOME at a harness-starter clone\n' "$ROOT" >"$contract_tmp"
    fi
  fi
  # Fresh clone's first session: Claude Code only discovers skills present at
  # launch, so name each shared SKILL.md to read directly this time — it
  # loads natively from the next.
  append_tmp=""
  if [ "$skill_linked_new" -eq 1 ]; then
    append_tmp="$(mktemp)" || fail "cannot make a temp file" "check /tmp"
    {
      printf 'note: this run linked shared skills — Claude Code only discovers skills present at launch, so read SKILL.md directly this session; it loads natively from the next:\n'
      for d in "$ROOT/.claude/skills" "$ROOT/.agents/skills"; do
        if [ -d "$d" ]; then
          for f in "$d"/*/SKILL.md; do
            if [ -e "$f" ] || [ -L "$f" ]; then
              printf '  %s\n' "$f"
            fi
          done
        fi
      done
    } >"$append_tmp"
  fi
  # A project copy shadows the shared one, the same way dispatch resolves.
  if [ -f "$PROJECT/scripts/brief.sh" ]; then
    brief_file="$PROJECT/scripts/brief.sh"
  elif [ -f "$ROOT/scripts/brief.sh" ]; then
    brief_file="$ROOT/scripts/brief.sh"
  else
    rm -f "$contract_tmp" "$append_tmp"
    fail "brief is missing (no scripts/brief.sh under the project or $ROOT)" "re-resolve with a valid harness root"
  fi
  cd "$PROJECT" || fail "cannot cd to $PROJECT" "check the project directory"
  HARNESS_PROJECT="$PROJECT" HARNESS_ROOT="$ROOT" HARNESS_SOURCE="$SOURCE"
  export HARNESS_PROJECT HARNESS_ROOT HARNESS_SOURCE
  # One argv for every shape below: --prepend/--append only for files that
  # exist, so an empty flag never reaches brief.sh — it exits 2 on those,
  # which would leave a SessionStart hook with no JSON.
  brief_argv=()
  if [ "$hook_mode" -eq 1 ]; then
    brief_argv=(--hook)
  fi
  if [ -n "$contract_tmp" ] && [ -f "$contract_tmp" ]; then
    brief_argv=("${brief_argv[@]}" --prepend "$contract_tmp")
  fi
  if [ -n "$append_tmp" ] && [ -f "$append_tmp" ]; then
    brief_argv=("${brief_argv[@]}" --append "$append_tmp")
  fi
  # No exec: the temp files are cleaned up below whatever the brief exits.
  bash "$brief_file" "${brief_argv[@]}"
  rc=$?
  rm -f "$contract_tmp" "$append_tmp"
  exit "$rc"
}

cmd_hook() {
  if [ $# -lt 1 ]; then
    fail "usage: h hook <name> [args]" "use: h hook commit-msg <msg-file>" 2
  fi
  name="$1"
  shift
  case "$name" in
    */..*|../*|*/../*|*/|*//*|\.\.)
      fail "bad hook name '$name'" "use a file directly under scripts/hooks/" 2
      ;;
  esac
  # Fail closed: an unresolvable harness exits 1 so commit-msg never passes
  # on a missing check.
  resolve
  hook_file="$ROOT/scripts/hooks/$name"
  if [ ! -f "$hook_file" ] && [ ! -L "$hook_file" ]; then
    fail "no such hook '$name'" "use one of: $(ls "$ROOT/scripts/hooks" 2>/dev/null | tr '\n' ' ')"
  fi
  if [ ! -x "$hook_file" ]; then
    fail "hook '$name' is not executable" "chmod +x $hook_file"
  fi
  cd "$PROJECT" || fail "cannot cd to $PROJECT" "check the project directory"
  HARNESS_PROJECT="$PROJECT" HARNESS_ROOT="$ROOT" HARNESS_SOURCE="$SOURCE"
  export HARNESS_PROJECT HARNESS_ROOT HARNESS_SOURCE
  exec "$hook_file" "$@"
}

cmd_dispatch() {
  name="$1"
  shift
  case "$name" in
    brief) file="brief.sh" ;;
    verify) file="verify.sh" ;;
    review) file="review.sh" ;;
    reflect) file="reflect.sh" ;;
    wrap-up) file="wrap-up.sh" ;;
    ledger-push) file="ledger-push.sh" ;;
    ledger-export-check) file="ledger-export-check.sh" ;;
    agent) file="agent.py" ;;
    context) file="context.py" ;;
    dashboard) file="dashboard.py" ;;
    dashboard-persist) file="dashboard-persist.sh" ;;
    models) file="models.py" ;;
    codex-support) file="codex-support.py" ;;
    opencode-agents) file="opencode-agents.py" ;;
    opencode-pin) file="opencode-pin.py" ;;
    *) fail "no such command '$name'" "use one of: root doctor link session hook brief verify review reflect wrap-up ledger-push ledger-export-check agent context dashboard dashboard-persist models codex-support opencode-agents opencode-pin" 2 ;; 
  esac
  # A project copy shadows the shared one; that is how overlays win.
  if [ -f "$PROJECT/scripts/$file" ]; then
    file="$PROJECT/scripts/$file"
  elif [ -f "$ROOT/scripts/$file" ]; then
    file="$ROOT/scripts/$file"
  else
    fail "$name is missing (no scripts/$(basename "$file") under the project or $ROOT)" "re-resolve with a valid harness root"
  fi
  cd "$PROJECT" || fail "cannot cd to $PROJECT" "check the project directory"
  HARNESS_PROJECT="$PROJECT" HARNESS_ROOT="$ROOT" HARNESS_SOURCE="$SOURCE"
  export HARNESS_PROJECT HARNESS_ROOT HARNESS_SOURCE
  case "$file" in
    *.py) exec python3 "$file" "$@" ;;
    *) exec bash "$file" "$@" ;;
  esac
}

# Hand the command to the shared finder when it is a different file from this
# one. Resolution runs in a subshell so a failure stays this finder's to
# report, loudly, through the command it was given (session stays exit 0).
hand_over() {
  local found root source
  [ -z "$HANDED_ROOT" ] || return 0
  found="$( resolve 2>/dev/null && printf '%s\n%s' "$ROOT" "$SOURCE" )" || return 0
  root="${found%%$'\n'*}"
  source="${found#*$'\n'}"
  [ -f "$root/scripts/harness" ] || return 0
  [ "$root/scripts/harness" -ef "$FINDER_DIR/$(basename "$0")" ] && return 0
  HARNESS_FINDER_PROJECT="$PROJECT" HARNESS_FINDER_ROOT="$root" HARNESS_FINDER_SOURCE="$source"
  export HARNESS_FINDER_PROJECT HARNESS_FINDER_ROOT HARNESS_FINDER_SOURCE
  exec bash "$root/scripts/harness" "$@"
}

main() {
  case "${1:-}" in ""|-h|--help) ;; *) hand_over "$@" ;; esac
  if [ $# -eq 0 ]; then
    usage
    exit 0
  fi
  case "$1" in
    -h|--help)
      usage
      ;;
    root)
      resolve
      printf '%s\n' "$ROOT"
      ;;
    doctor)
      resolve
      cmd_doctor
      ;;
    link)
      resolve
      cmd_link
      ;;
    session)
      shift
      cmd_session "$@"
      ;;
    hook)
      shift
      cmd_hook "$@"
      ;;
    *)
      resolve
      cmd_dispatch "$@"
      ;;
  esac
}

main "$@"
