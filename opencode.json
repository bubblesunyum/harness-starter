{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md", "CLAUDE.md"],
  "permission": {
    "external_directory": {
      "/tmp/*": "allow",
      "/private/tmp/*": "allow"
    },
    "edit": {
      "/tmp/*": "deny",
      "/private/tmp/*": "deny",
      "/var/folders/*": "deny",
      "/private/var/folders/*": "deny"
    },
    "bash": {
      "*": "allow",
      "*>*/tmp/*": "deny",
      "*>*/private/tmp/*": "deny",
      "*>*/var/folders/*": "deny",
      "*>*/private/var/folders/*": "deny",
      "*>*TMPDIR*": "deny"
    }
  }
}
